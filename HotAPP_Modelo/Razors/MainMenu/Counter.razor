@page "/counter"
@rendermode InteractiveAuto

<PageTitle>@MenuName()</PageTitle>

<h1>@MenuName()</h1>

<div role="status" style="padding-bottom: 1em;">
    Current count: <FluentBadge Appearance="Appearance.Neutral">@currentCount</FluentBadge>
</div>

<FluentButton Appearance="Appearance.Accent" @onclick="IncrementCount">Click me</FluentButton>

@code {
    public static string MenuName() => "Counter";
    public static Icon MenuIcon() => new Icons.Regular.Size20.NumberSymbol();

    private int currentCount = 0;

    private void IncrementCount() {
        currentCount++;
    }
}
